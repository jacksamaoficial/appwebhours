# Copy to .env next to docker-compose.prod.yml and fill in. Never commit it.
PUBLIC_URL=https://gestion.jacksocialclub.com
PUBLIC_HOST=gestion.jacksocialclub.com   # Traefik routes this host to the app
SECRET_KEY=            # openssl rand -hex 32
POSTGRES_PASSWORD=     # openssl rand -hex 24
ADMIN_EMAILS=          # who can open "Copias de seguridad"
ALLOW_REGISTRATION=false
TZ=Europe/Madrid
# BACKUP_RCLONE_REMOTE=gdrive:jacksocialclub-backups
